import { isFn, isNullish, objGet, objSet, push, undef } from "./host.lil";
import { gfm } from "./micromark/gfm.lil";
import { gfmFromMarkdown, gfmToMarkdown } from "./mdast/gfm.lil";

JsValue remarkGfmCall(JsValue self, JsValue options) {
  JsValue settings = options;
  if (isNullish(settings)) {
    settings = JS.object();
  }
  JsValue dataFn = objGet(self, "data");
  JsValue data = JS.object();
  if (isFn(dataFn)) {
    data = JS.call(dataFn, self);
    if (isNullish(data)) {
      data = JS.object();
    }
  }
  JsValue micromarkExtensions = objGet(data, "micromarkExtensions");
  if (isNullish(micromarkExtensions)) {
    micromarkExtensions = JS.array();
    objSet(data, "micromarkExtensions", micromarkExtensions);
  }
  JsValue fromMarkdownExtensions = objGet(data, "fromMarkdownExtensions");
  if (isNullish(fromMarkdownExtensions)) {
    fromMarkdownExtensions = JS.array();
    objSet(data, "fromMarkdownExtensions", fromMarkdownExtensions);
  }
  JsValue toMarkdownExtensions = objGet(data, "toMarkdownExtensions");
  if (isNullish(toMarkdownExtensions)) {
    toMarkdownExtensions = JS.array();
    objSet(data, "toMarkdownExtensions", toMarkdownExtensions);
  }
  push(micromarkExtensions, gfm(settings));
  push(fromMarkdownExtensions, gfmFromMarkdown());
  push(toMarkdownExtensions, gfmToMarkdown(settings));
  return undef();
}

export JsValue remarkGfm = JS.method1(remarkGfmCall);
export JsValue default = remarkGfm;
