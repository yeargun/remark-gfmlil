import { combineExtensions, combineHtmlExtensions } from "../util-combine-extensions.lil";
import { gfmAutolinkLiteral, gfmAutolinkLiteralHtml } from "./gfm-autolink-literal.lil";
import { gfmFootnote, gfmFootnoteHtml } from "./gfm-footnote.lil";
import { gfmStrikethrough, gfmStrikethroughHtml } from "./gfm-strikethrough.lil";
import { gfmTable, gfmTableHtml } from "./gfm-table.lil";
import { gfmTagfilterHtml } from "./gfm-tagfilter.lil";
import { gfmTaskListItem, gfmTaskListItemHtml } from "./gfm-task-list-item.lil";

export JsValue gfm(JsValue options) {
  return combineExtensions(JS.array(
    gfmAutolinkLiteral(),
    gfmFootnote(),
    gfmStrikethrough(options),
    gfmTable(),
    gfmTaskListItem()
  ));
}

export JsValue gfmHtml(JsValue options) {
  return combineHtmlExtensions(JS.array(
    gfmAutolinkLiteralHtml(),
    gfmFootnoteHtml(options),
    gfmStrikethroughHtml(),
    gfmTableHtml(),
    gfmTagfilterHtml(),
    gfmTaskListItemHtml()
  ));
}
