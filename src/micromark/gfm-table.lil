import { arrLen, call1, call3, copyPoint, eventEnter, eventExit, fxConsume, fxEnter, fxExit, go, includesVal, isEof, isNullish, jsInt, jsString, nowOf, nullMap, objGet, objGetVal, objSet, push, setTokenType, undef } from "../host.lil";
import { factorySpace } from "../factory-space.lil";
import { markdownLineEnding, markdownLineEndingOrSpace, markdownSpace } from "../util-character.lil";
import { cBackslash, cColon, cDash, cVerticalBar, codeEq } from "../symbol/codes.lil";
import { kContentTypeText, kTabSize } from "../symbol/constants.lil";
import { tChunkText, tData, tLineEnding, tLinePrefix, tWhitespace } from "../symbol/types.lil";
import { createEditMap } from "./gfm-table-edit-map.lil";
import { gfmTableAlign } from "./gfm-table-infer.lil";

JsValue getPoint(JsValue events, int index) {
  JsValue event = events[index];
  string side = "end";
  if (event[0] == "enter") {
    side = "start";
  }
  return objGet(event[1], side);
}

JsValue flushCell(JsValue map, JsValue context, CellRange range, int rowKind, JsValue rowEnd, JsValue previousCell) {
  string groupName = "tableData";
  if (rowKind == 1) {
    groupName = "tableHeader";
  } else if (rowKind == 2) {
    groupName = "tableDelimiter";
  }
  string valueName = "tableContent";
  if (range.before != 0) {
    objSet(previousCell, "end", copyPoint(getPoint(objGet(context, "events"), range.before)));
    JsValue prevExit = JS.array();
    push(prevExit, eventExit(previousCell, context));
    call3(objGet(map, "add"), map, range.before, 0, prevExit);
  }
  JsValue now = getPoint(objGet(context, "events"), range.start);
  previousCell = JS.object();
  objSet(previousCell, "type", groupName);
  objSet(previousCell, "start", copyPoint(now));
  objSet(previousCell, "end", copyPoint(now));
  JsValue enterCell = JS.array();
  push(enterCell, eventEnter(previousCell, context));
  call3(objGet(map, "add"), map, range.start, 0, enterCell);
  if (range.contentStart != 0) {
    JsValue relatedStart = getPoint(objGet(context, "events"), range.contentStart);
    JsValue relatedEnd = getPoint(objGet(context, "events"), range.contentEnd);
    JsValue valueToken = JS.object();
    objSet(valueToken, "type", valueName);
    objSet(valueToken, "start", copyPoint(relatedStart));
    objSet(valueToken, "end", copyPoint(relatedEnd));
    JsValue enterValue = JS.array();
    push(enterValue, eventEnter(valueToken, context));
    call3(objGet(map, "add"), map, range.contentStart, 0, enterValue);
    if (rowKind != 2) {
      JsValue start = objGet(context, "events")[range.contentStart];
      JsValue end = objGet(context, "events")[range.contentEnd];
      objSet(start[1], "end", copyPoint(objGet(end[1], "end")));
      setTokenType(start[1], tChunkText);
      objSet(start[1], "contentType", kContentTypeText);
      if (range.contentEnd > range.contentStart + 1) {
        int a = range.contentStart + 1;
        int b = range.contentEnd - range.contentStart - 1;
        call3(objGet(map, "add"), map, a, b, JS.array());
      }
    }
    JsValue exitValue = JS.array();
    push(exitValue, eventExit(valueToken, context));
    call3(objGet(map, "add"), map, range.contentEnd + 1, 0, exitValue);
  }
  if (!isNullish(rowEnd)) {
    objSet(previousCell, "end", copyPoint(getPoint(objGet(context, "events"), jsInt(rowEnd))));
    JsValue exitCell = JS.array();
    push(exitCell, eventExit(previousCell, context));
    call3(objGet(map, "add"), map, rowEnd, 0, exitCell);
    previousCell = undef();
  }
  return previousCell;
}

void flushTableEnd(JsValue map, JsValue context, int index, JsValue table, JsValue tableBody) {
  JsValue exits = JS.array();
  JsValue related = getPoint(objGet(context, "events"), index);
  if (tableBody.truthy()) {
    objSet(tableBody, "end", copyPoint(related));
    push(exits, eventExit(tableBody, context));
  }
  objSet(table, "end", copyPoint(related));
  push(exits, eventExit(table, context));
  call3(objGet(map, "add"), map, index + 1, 0, exits);
}

class CellRange {
  int before;
  int start;
  int contentStart;
  int contentEnd;
}

class TableState {
  bool pipe;
  int rowKind;
  CellRange lastCell;
  CellRange cell;
  bool afterHead;
  int lastTableEnd;
  JsValue table;
  JsValue body;
  JsValue currentCell;
}

TableState newTableState() {
  TableState st = new TableState();
  st.pipe = true;
  st.lastCell = new CellRange();
  st.cell = new CellRange();
  return st;
}

void applyTableEnter(TableState st, JsValue context, JsValue map, int index, JsValue token, string tokenType) {
  int rowKind = st.rowKind;
  CellRange lastCell = st.lastCell;
  CellRange cell = st.cell;
  JsValue currentCell = st.currentCell;
  if (tokenType == "tableHead") {
    st.afterHead = false;
    int lastTableEnd = st.lastTableEnd;
    if (lastTableEnd != 0) {
      flushTableEnd(map, context, lastTableEnd, st.table, st.body);
      st.body = undef();
      st.lastTableEnd = 0;
    }
    JsValue currentTable = JS.object();
    objSet(currentTable, "type", "table");
    objSet(currentTable, "start", copyPoint(objGet(token, "start")));
    objSet(currentTable, "end", copyPoint(objGet(token, "end")));
    st.table = currentTable;
    JsValue enterTable = JS.array();
    push(enterTable, eventEnter(currentTable, context));
    call3(objGet(map, "add"), map, index, 0, enterTable);
    return;
  }
  if (tokenType == "tableRow" || tokenType == "tableDelimiterRow") {
    st.pipe = true;
    st.currentCell = undef();
    lastCell = new CellRange();
    cell = new CellRange();
    cell.start = index + 1;
    st.lastCell = lastCell;
    st.cell = cell;
    if (st.afterHead) {
      st.afterHead = false;
      JsValue currentBody = JS.object();
      objSet(currentBody, "type", "tableBody");
      objSet(currentBody, "start", copyPoint(objGet(token, "start")));
      objSet(currentBody, "end", copyPoint(objGet(token, "end")));
      st.body = currentBody;
      JsValue enterBody = JS.array();
      push(enterBody, eventEnter(currentBody, context));
      call3(objGet(map, "add"), map, index, 0, enterBody);
    }
    if (tokenType == "tableDelimiterRow") {
      st.rowKind = 2;
    } else if (st.body.truthy()) {
      st.rowKind = 3;
    } else {
      st.rowKind = 1;
    }
    return;
  }
  if (rowKind != 0 && (tokenType == tData || tokenType == "tableDelimiterMarker" || tokenType == "tableDelimiterFiller")) {
    st.pipe = false;
    if (cell.contentStart == 0) {
      if (lastCell.start != 0) {
        cell.before = cell.start;
        currentCell = flushCell(map, context, lastCell, rowKind, undef(), currentCell);
        lastCell = new CellRange();
        st.lastCell = lastCell;
        st.currentCell = currentCell;
      }
      cell.contentStart = index;
    }
    return;
  }
  if (tokenType == "tableCellDivider") {
    if (st.pipe) {
      st.pipe = false;
      return;
    }
    if (lastCell.start != 0) {
      cell.before = cell.start;
      currentCell = flushCell(map, context, lastCell, rowKind, undef(), currentCell);
      st.currentCell = currentCell;
    }
    st.lastCell = cell;
    cell = new CellRange();
    cell.before = st.lastCell.start;
    cell.start = index;
    st.cell = cell;
  }
}

void applyTableExit(TableState st, JsValue context, JsValue map, int index, string tokenType) {
  int rowKind = st.rowKind;
  CellRange lastCell = st.lastCell;
  CellRange cell = st.cell;
  JsValue currentCell = st.currentCell;
  if (tokenType == "tableHead") {
    st.afterHead = true;
    st.lastTableEnd = index;
    return;
  }
  if (tokenType == "tableRow" || tokenType == "tableDelimiterRow") {
    st.lastTableEnd = index;
    if (lastCell.start != 0) {
      cell.before = cell.start;
      currentCell = flushCell(map, context, lastCell, rowKind, index, currentCell);
      st.currentCell = currentCell;
    } else if (cell.start != 0) {
      currentCell = flushCell(map, context, cell, rowKind, index, currentCell);
      st.currentCell = currentCell;
    }
    st.rowKind = 0;
    return;
  }
  if (rowKind != 0 && (tokenType == tData || tokenType == "tableDelimiterMarker" || tokenType == "tableDelimiterFiller")) {
    cell.contentEnd = index;
  }
}

JsValue resolveTable = JS.method2((JsValue _self, JsValue events, JsValue context) => {
  TableState st = newTableState();
  JsValue map = createEditMap();
  int index = -1;
  int n = arrLen(events);
  while (true) {
    index = index + 1;
    if (index >= n) {
      break;
    }
    JsValue event = events[index];
    JsValue token = event[1];
    string tokenType = jsString(objGet(token, "type"));
    if (event[0] == "enter") {
      applyTableEnter(st, context, map, index, token, tokenType);
    } else {
      applyTableExit(st, context, map, index, tokenType);
    }
  }
  int lastTableEnd = st.lastTableEnd;
  if (lastTableEnd != 0) {
    flushTableEnd(map, context, lastTableEnd, st.table, st.body);
  }
  call1(objGet(map, "consume"), map, objGet(context, "events"));
  index = -1;
  n = arrLen(objGet(context, "events"));
  while (true) {
    index = index + 1;
    if (index >= n) {
      break;
    }
    JsValue ev = objGet(context, "events")[index];
    if (ev[0] == "enter" && objGet(ev[1], "type") == "table") {
      objSet(ev[1], "_align", gfmTableAlign(objGet(context, "events"), index));
    }
  }
  return events;
});

JsValue tokenizeTable = JS.method3((JsValue self, JsValue effects, JsValue ok, JsValue nok) => {
  int size = 0;
  int sizeB = 0;
  bool seen = false;
  JsValue bodyRowData = undef();
  JsValue bodyRowBreak = undef();
  JsValue headDelimiterBefore = undef();
  JsValue headDelimiterFiller = undef();
  JsValue headRowData = undef();
  JsValue headRowBreak = undef();

  JsValue bodyRowEscape = JS.method1((JsValue _s, JsValue code) => {
    if (codeEq(code, cBackslash) || codeEq(code, cVerticalBar)) {
      fxConsume(effects, code);
      return bodyRowData;
    }
    return go(bodyRowData, code);
  });

  bodyRowData = JS.method1((JsValue _s, JsValue code) => {
    if (isEof(code) || codeEq(code, cVerticalBar) || markdownLineEndingOrSpace(code)) {
      fxExit(effects, tData);
      return go(bodyRowBreak, code);
    }
    fxConsume(effects, code);
    if (codeEq(code, cBackslash)) {
      return bodyRowEscape;
    }
    return bodyRowData;
  });

  bodyRowBreak = JS.method1((JsValue _s, JsValue code) => {
    if (codeEq(code, cVerticalBar)) {
      fxEnter(effects, "tableCellDivider");
      fxConsume(effects, code);
      fxExit(effects, "tableCellDivider");
      return bodyRowBreak;
    }
    if (isEof(code) || markdownLineEnding(code)) {
      fxExit(effects, "tableRow");
      return go(ok, code);
    }
    if (markdownSpace(code)) {
      return go(factorySpace(effects, bodyRowBreak, tWhitespace, undef()), code);
    }
    fxEnter(effects, tData);
    return go(bodyRowData, code);
  });

  JsValue bodyRowStart = JS.method1((JsValue _s, JsValue code) => {
    fxEnter(effects, "tableRow");
    return go(bodyRowBreak, code);
  });

  JsValue headDelimiterNok = JS.method1((JsValue _s, JsValue code) => {
    return go(nok, code);
  });

  headDelimiterBefore = JS.method1((JsValue _s, JsValue code) => {
    return go(headDelimiterBefore, code);
  });

  JsValue headDelimiterCellAfter = JS.method1((JsValue _s, JsValue code) => {
    if (codeEq(code, cVerticalBar)) {
      return go(headDelimiterBefore, code);
    }
    if (isEof(code) || markdownLineEnding(code)) {
      if (!seen || size != sizeB) {
        return go(headDelimiterNok, code);
      }
      fxExit(effects, "tableDelimiterRow");
      fxExit(effects, "tableHead");
      return go(ok, code);
    }
    return go(headDelimiterNok, code);
  });

  JsValue headDelimiterRightAlignmentAfter = JS.method1((JsValue _s, JsValue code) => {
    if (markdownSpace(code)) {
      return go(factorySpace(effects, headDelimiterCellAfter, tWhitespace, undef()), code);
    }
    return go(headDelimiterCellAfter, code);
  });

  headDelimiterFiller = JS.method1((JsValue _s, JsValue code) => {
    if (codeEq(code, cDash)) {
      fxConsume(effects, code);
      return headDelimiterFiller;
    }
    if (codeEq(code, cColon)) {
      seen = true;
      fxExit(effects, "tableDelimiterFiller");
      fxEnter(effects, "tableDelimiterMarker");
      fxConsume(effects, code);
      fxExit(effects, "tableDelimiterMarker");
      return headDelimiterRightAlignmentAfter;
    }
    fxExit(effects, "tableDelimiterFiller");
    return go(headDelimiterRightAlignmentAfter, code);
  });

  JsValue headDelimiterLeftAlignmentAfter = JS.method1((JsValue _s, JsValue code) => {
    if (codeEq(code, cDash)) {
      fxEnter(effects, "tableDelimiterFiller");
      return go(headDelimiterFiller, code);
    }
    return go(headDelimiterNok, code);
  });

  JsValue headDelimiterValueBefore = JS.method1((JsValue _s, JsValue code) => {
    if (codeEq(code, cColon)) {
      sizeB = sizeB + 1;
      seen = true;
      fxEnter(effects, "tableDelimiterMarker");
      fxConsume(effects, code);
      fxExit(effects, "tableDelimiterMarker");
      return headDelimiterLeftAlignmentAfter;
    }
    if (codeEq(code, cDash)) {
      sizeB = sizeB + 1;
      return go(headDelimiterLeftAlignmentAfter, code);
    }
    if (isEof(code) || markdownLineEnding(code)) {
      return go(headDelimiterCellAfter, code);
    }
    return go(headDelimiterNok, code);
  });

  JsValue headDelimiterCellBefore = JS.method1((JsValue _s, JsValue code) => {
    if (markdownSpace(code)) {
      return go(factorySpace(effects, headDelimiterValueBefore, tWhitespace, undef()), code);
    }
    return go(headDelimiterValueBefore, code);
  });

  JsValue headDelimiterBeforeReal = JS.method1((JsValue _s, JsValue code) => {
    if (codeEq(code, cDash) || codeEq(code, cColon)) {
      return go(headDelimiterValueBefore, code);
    }
    if (codeEq(code, cVerticalBar)) {
      seen = true;
      fxEnter(effects, "tableCellDivider");
      fxConsume(effects, code);
      fxExit(effects, "tableCellDivider");
      return headDelimiterCellBefore;
    }
    return go(headDelimiterNok, code);
  });
  headDelimiterBefore = headDelimiterBeforeReal;

  JsValue headDelimiterStart = JS.method1((JsValue _s, JsValue code) => {
    objSet(self, "interrupt", false);
    JsValue lazy = objGet(objGet(self, "parser"), "lazy");
    if (objGetVal(lazy, objGet(nowOf(self), "line")).truthy()) {
      return go(nok, code);
    }
    fxEnter(effects, "tableDelimiterRow");
    seen = false;
    if (markdownSpace(code)) {
      JsValue max = kTabSize;
      JsValue disable = objGet(objGet(objGet(self, "parser"), "constructs"), "disable");
      if (!isNullish(disable) && includesVal(objGet(disable, "null"), "codeIndented")) {
        max = undef();
      }
      return go(factorySpace(effects, headDelimiterBeforeReal, tLinePrefix, max), code);
    }
    return go(headDelimiterBeforeReal, code);
  });

  JsValue headRowEscape = JS.method1((JsValue _s, JsValue code) => {
    if (codeEq(code, cBackslash) || codeEq(code, cVerticalBar)) {
      fxConsume(effects, code);
      return headRowData;
    }
    return go(headRowData, code);
  });

  headRowData = JS.method1((JsValue _s, JsValue code) => {
    if (isEof(code) || codeEq(code, cVerticalBar) || markdownLineEndingOrSpace(code)) {
      fxExit(effects, tData);
      return go(headRowBreak, code);
    }
    fxConsume(effects, code);
    if (codeEq(code, cBackslash)) {
      return headRowEscape;
    }
    return headRowData;
  });

  headRowBreak = JS.method1((JsValue _s, JsValue code) => {
    if (isEof(code)) {
      return go(nok, code);
    }
    if (markdownLineEnding(code)) {
      if (sizeB > 1) {
        sizeB = 0;
        objSet(self, "interrupt", true);
        fxExit(effects, "tableRow");
        fxEnter(effects, tLineEnding);
        fxConsume(effects, code);
        fxExit(effects, tLineEnding);
        return headDelimiterStart;
      }
      return go(nok, code);
    }
    if (markdownSpace(code)) {
      return go(factorySpace(effects, headRowBreak, tWhitespace, undef()), code);
    }
    sizeB = sizeB + 1;
    if (seen) {
      seen = false;
      size = size + 1;
    }
    if (codeEq(code, cVerticalBar)) {
      fxEnter(effects, "tableCellDivider");
      fxConsume(effects, code);
      fxExit(effects, "tableCellDivider");
      seen = true;
      return headRowBreak;
    }
    fxEnter(effects, tData);
    return go(headRowData, code);
  });

  JsValue headRowStart = JS.method1((JsValue _s, JsValue code) => {
    if (codeEq(code, cVerticalBar)) {
      return go(headRowBreak, code);
    }
    seen = true;
    sizeB = sizeB + 1;
    return go(headRowBreak, code);
  });

  JsValue headRowBefore = JS.method1((JsValue _s, JsValue code) => {
    fxEnter(effects, "tableHead");
    fxEnter(effects, "tableRow");
    return go(headRowStart, code);
  });

  JsValue start = JS.method1((JsValue _s, JsValue code) => {
    int index = arrLen(objGet(self, "events")) - 1;
    JsValue evs = objGet(self, "events");
    while (index > -1) {
      string typ = jsString(objGet(evs[index][1], "type"));
      if (typ == tLineEnding || typ == tLinePrefix) {
        index = index - 1;
      } else {
        break;
      }
    }
    string tail = "";
    if (index > -1) {
      tail = jsString(objGet(evs[index][1], "type"));
    }
    if (tail == "tableHead" || tail == "tableRow") {
      JsValue lazy = objGet(objGet(self, "parser"), "lazy");
      if (objGetVal(lazy, objGet(nowOf(self), "line")).truthy()) {
        return go(nok, code);
      }
      return go(bodyRowStart, code);
    }
    return go(headRowBefore, code);
  });

  return start;
});

export JsValue gfmTable() {
  JsValue table = JS.object("name", "table", "tokenize", tokenizeTable, "resolveAll", resolveTable);
  return JS.object("flow", nullMap(table));
}

export JsValue gfmTableHtml() {
  return JS.object();
}
