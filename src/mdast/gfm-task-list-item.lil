import { arrLen, call0, call1, jsString, objectAssign, objGet, objSet, pin, push, replaceFn, undef } from "../host.lil";
import { defaultHandlers } from "../to-markdown/handle.lil";

JsValue exitCheck = JS.method1((JsValue self, JsValue token) => {
  JsValue stack = objGet(self, "stack");
  JsValue node = stack[JS.number(JS.get(stack, "length")).toInt() - 2];
  objSet(node, "checked", objGet(token, "type") == "taskListCheckValueChecked");
  return undef();
});

JsValue exitParagraphWithTaskListItem = JS.method1((JsValue self, JsValue token) => {
  JsValue stack = objGet(self, "stack");
  int stackLen = JS.number(JS.get(stack, "length")).toInt();
  JsValue parent = stack[stackLen - 2];
  if (parent.truthy() && objGet(parent, "type") == "listItem" && JS.typeOf(objGet(parent, "checked")) == "boolean") {
    JsValue node = stack[stackLen - 1];
    JsValue kids = objGet(node, "children");
    JsValue head = undef();
    if (arrLen(kids) > 0) {
      head = kids[0];
    }
    if (head.truthy() && objGet(head, "type") == "text") {
      JsValue siblings = objGet(parent, "children");
      int index = -1;
      int n = arrLen(siblings);
      JsValue firstParagraph = undef();
      while (true) {
        index = index + 1;
        if (index >= n) {
          break;
        }
        if (objGet(siblings[index], "type") == "paragraph") {
          firstParagraph = siblings[index];
          break;
        }
      }
      if (firstParagraph == node) {
        objSet(head, "value", jsString(objGet(head, "value")).slice(1));
        if (jsString(objGet(head, "value")).length == 0) {
          JS.call(JS.get(kids, "shift"), kids);
        } else {
          JsValue nodePos = objGet(node, "position");
          JsValue headPos = objGet(head, "position");
          if (nodePos.truthy() && headPos.truthy() && JS.typeOf(objGet(objGet(headPos, "start"), "offset")) == "number") {
            JsValue start = objGet(headPos, "start");
            objSet(start, "column", JS.number(objGet(start, "column")) + 1.0);
            objSet(start, "offset", JS.number(objGet(start, "offset")) + 1.0);
            objSet(nodePos, "start", objectAssign(JS.object(), objGet(headPos, "start")));
          }
        }
      }
    }
  }
  call1(objGet(self, "exit"), self, token);
  return undef();
});

JsValue listItemWithTaskListItem = JS.methodRest((JsValue _self, JsValue args) => {
  JsValue node = args[0];
  JsValue parent = args[1];
  JsValue state = args[2];
  JsValue info = args[3];
  JsValue kids = objGet(node, "children");
  JsValue head = undef();
  if (arrLen(kids) > 0) {
    head = kids[0];
  }
  bool checkable = JS.typeOf(objGet(node, "checked")) == "boolean" && head.truthy() && objGet(head, "type") == "paragraph";
  string checkbox = "[ ] ";
  if (objGet(node, "checked").truthy()) {
    checkbox = "[x] ";
  }
  JsValue tracker = call1(objGet(state, "createTracker"), state, info);
  if (checkable) {
    call1(objGet(tracker, "move"), tracker, checkbox);
  }
  JsValue nextInfo = call0(objGet(tracker, "current"), tracker);
  objSet(nextInfo, "before", objGet(info, "before"));
  objSet(nextInfo, "after", objGet(info, "after"));
  objSet(nextInfo, "now", objGet(nextInfo, "now"));
  string value = jsString(JS.call(objGet(defaultHandlers, "listItem"), undef(), node, parent, state, nextInfo));
  if (checkable) {
    string box = checkbox;
    value = jsString(replaceFn(value, new Regex("^(?:[*+-]|\\d+\\.)([\\r\\n]| {1,3})", ""), JS.methodRest((JsValue _s, JsValue m) => {
      return jsString(m[0]) + box;
    })));
  }
  return value;
});

export JsValue gfmTaskListItemFromMarkdown() {
  JsValue exit = JS.object();
  pin(exit, "taskListCheckValueChecked", exitCheck);
  pin(exit, "taskListCheckValueUnchecked", exitCheck);
  pin(exit, "paragraph", exitParagraphWithTaskListItem);
  JsValue ext = JS.object();
  pin(ext, "exit", exit);
  return ext;
}

export JsValue gfmTaskListItemToMarkdown() {
  JsValue unsafe = JS.array();
  JsValue u = JS.object();
  objSet(u, "atBreak", true);
  objSet(u, "character", "-");
  objSet(u, "after", "[:|-]");
  push(unsafe, u);
  JsValue handlers = JS.object();
  pin(handlers, "listItem", listItemWithTaskListItem);
  JsValue ext = JS.object();
  pin(ext, "unsafe", unsafe);
  pin(ext, "handlers", handlers);
  return ext;
}
