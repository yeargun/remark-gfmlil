import { jsString } from "../host.lil";

export int ccount(JsValue value, string character) {
  string source = jsString(value);
  int count = 0;
  int index = source.indexOf(character);
  int step = character.length;
  if (step < 1) {
    return 0;
  }
  while (index != -1) {
    count = count + 1;
    index = source.indexOf(character, index + step);
  }
  return count;
}
