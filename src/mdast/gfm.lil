import { optionOrEmpty } from "../host.lil";
import { gfmAutolinkLiteralFromMarkdown, gfmAutolinkLiteralToMarkdown } from "./gfm-autolink-literal.lil";
import { gfmFootnoteFromMarkdown, gfmFootnoteToMarkdown } from "./gfm-footnote.lil";
import { gfmStrikethroughFromMarkdown, gfmStrikethroughToMarkdown } from "./gfm-strikethrough.lil";
import { gfmTableFromMarkdown, gfmTableToMarkdown } from "./gfm-table.lil";
import { gfmTaskListItemFromMarkdown, gfmTaskListItemToMarkdown } from "./gfm-task-list-item.lil";

export JsValue gfmFromMarkdown() {
  return JS.array(
    gfmAutolinkLiteralFromMarkdown(),
    gfmFootnoteFromMarkdown(),
    gfmStrikethroughFromMarkdown(),
    gfmTableFromMarkdown(),
    gfmTaskListItemFromMarkdown()
  );
}

export JsValue gfmToMarkdown(JsValue options) {
  JsValue settings = optionOrEmpty(options);
  return JS.object("extensions", JS.array(
    gfmAutolinkLiteralToMarkdown(),
    gfmFootnoteToMarkdown(settings),
    gfmStrikethroughToMarkdown(),
    gfmTableToMarkdown(settings),
    gfmTaskListItemToMarkdown()
  ));
}
