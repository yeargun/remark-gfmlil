import { arrLen, call0, call1, call2, jsNull, jsString, objGet, objSet, optionOrEmpty, pin, push, replaceFn, undef } from "../host.lil";
import { markdownTable } from "./markdown-table.lil";
import { defaultHandlers } from "../to-markdown/handle.lil";

Regex pipeEscape = new Regex("\\\\([\\\\|])", "g");
Regex pipeOnly = new Regex("\\|", "g");

JsValue replacePipe = JS.methodRest((JsValue _self, JsValue args) => {
  string group = jsString(args[1]);
  if (group == "|") {
    return group;
  }
  return args[0];
});

JsValue enterTable = JS.method1((JsValue self, JsValue token) => {
  JsValue align = objGet(token, "_align");
  JsValue mapped = JS.array();
  int i = 0;
  int n = arrLen(align);
  while (i < n) {
    if (align[i] == "none") {
      push(mapped, jsNull());
    } else {
      push(mapped, align[i]);
    }
    i = i + 1;
  }
  JsValue node = JS.object();
  objSet(node, "type", "table");
  objSet(node, "align", mapped);
  objSet(node, "children", JS.array());
  objSet(node, "position", undef());
  call2(objGet(self, "enter"), self, node, token);
  objSet(objGet(self, "data"), "inTable", true);
  return undef();
});

JsValue exitTable = JS.method1((JsValue self, JsValue token) => {
  call1(objGet(self, "exit"), self, token);
  objSet(objGet(self, "data"), "inTable", undef());
  return undef();
});

JsValue enterRow = JS.method1((JsValue self, JsValue token) => {
  JsValue node = JS.object();
  objSet(node, "type", "tableRow");
  objSet(node, "children", JS.array());
  objSet(node, "position", undef());
  call2(objGet(self, "enter"), self, node, token);
  return undef();
});

JsValue exitGeneric = JS.method1((JsValue self, JsValue token) => {
  call1(objGet(self, "exit"), self, token);
  return undef();
});

JsValue enterCell = JS.method1((JsValue self, JsValue token) => {
  JsValue node = JS.object();
  objSet(node, "type", "tableCell");
  objSet(node, "children", JS.array());
  objSet(node, "position", undef());
  call2(objGet(self, "enter"), self, node, token);
  return undef();
});

JsValue exitCodeText = JS.method1((JsValue self, JsValue token) => {
  JsValue value = call0(objGet(self, "resume"), self);
  if (objGet(objGet(self, "data"), "inTable").truthy()) {
    value = replaceFn(value, pipeEscape, replacePipe);
  }
  JsValue stack = objGet(self, "stack");
  JsValue node = stack[JS.number(JS.get(stack, "length")).toInt() - 1];
  objSet(node, "value", value);
  call1(objGet(self, "exit"), self, token);
  return undef();
});

export JsValue gfmTableFromMarkdown() {
  JsValue enter = JS.object();
  pin(enter, "table", enterTable);
  pin(enter, "tableData", enterCell);
  pin(enter, "tableHeader", enterCell);
  pin(enter, "tableRow", enterRow);
  JsValue exit = JS.object();
  pin(exit, "codeText", exitCodeText);
  pin(exit, "table", exitTable);
  pin(exit, "tableData", exitGeneric);
  pin(exit, "tableHeader", exitGeneric);
  pin(exit, "tableRow", exitGeneric);
  JsValue ext = JS.object();
  pin(ext, "enter", enter);
  pin(ext, "exit", exit);
  return ext;
}

export JsValue gfmTableToMarkdown(JsValue options) {
  JsValue settings = optionOrEmpty(options);
  JsValue padding = objGet(settings, "tableCellPadding");
  JsValue alignDelimiters = objGet(settings, "tablePipeAlign");
  JsValue stringLength = objGet(settings, "stringLength");
  string around = "|";
  if (padding.truthy()) {
    around = " ";
  }

  JsValue handleTableCell = JS.methodRest((JsValue _self, JsValue args) => {
    JsValue node = args[0];
    JsValue state = args[2];
    JsValue info = args[3];
    JsValue exit = call1(objGet(state, "enter"), state, "tableCell");
    JsValue subexit = call1(objGet(state, "enter"), state, "phrasing");
    JsValue phrasing = JS.object();
    objSet(phrasing, "before", around);
    objSet(phrasing, "after", around);
    objSet(phrasing, "now", objGet(info, "now"));
    objSet(phrasing, "lineShift", objGet(info, "lineShift"));
    string value = jsString(call2(objGet(state, "containerPhrasing"), state, node, phrasing));
    call0(subexit, undef());
    call0(exit, undef());
    return value;
  });

  JsValue handleTableRowAsData = JS.methodRest((JsValue _self, JsValue args) => {
    JsValue node = args[0];
    JsValue state = args[1];
    JsValue info = args[2];
    JsValue children = objGet(node, "children");
    int index = -1;
    JsValue result = JS.array();
    JsValue subexit = call1(objGet(state, "enter"), state, "tableRow");
    int n = arrLen(children);
    while (true) {
      index = index + 1;
      if (index >= n) {
        break;
      }
      JsValue cellArgs = JS.array();
      push(cellArgs, children[index]);
      push(cellArgs, node);
      push(cellArgs, state);
      push(cellArgs, info);
      result[index] = JS.call(JS.get(handleTableCell, "apply"), handleTableCell, undef(), cellArgs);
    }
    call0(subexit, undef());
    return result;
  });

  JsValue handleTableAsData = JS.methodRest((JsValue _self, JsValue args) => {
    JsValue node = args[0];
    JsValue state = args[1];
    JsValue info = args[2];
    JsValue children = objGet(node, "children");
    int index = -1;
    JsValue result = JS.array();
    JsValue subexit = call1(objGet(state, "enter"), state, "table");
    int n = arrLen(children);
    while (true) {
      index = index + 1;
      if (index >= n) {
        break;
      }
      JsValue rowArgs = JS.array();
      push(rowArgs, children[index]);
      push(rowArgs, state);
      push(rowArgs, info);
      result[index] = JS.call(JS.get(handleTableRowAsData, "apply"), handleTableRowAsData, undef(), rowArgs);
    }
    call0(subexit, undef());
    return result;
  });

  JsValue handleTable = JS.methodRest((JsValue _self, JsValue args) => {
    JsValue node = args[0];
    JsValue state = args[2];
    JsValue info = args[3];
    JsValue dataArgs = JS.array();
    push(dataArgs, node);
    push(dataArgs, state);
    push(dataArgs, info);
    JsValue opts = JS.object();
    objSet(opts, "align", objGet(node, "align"));
    objSet(opts, "alignDelimiters", alignDelimiters);
    objSet(opts, "padding", padding);
    objSet(opts, "stringLength", stringLength);
    return markdownTable(JS.call(JS.get(handleTableAsData, "apply"), handleTableAsData, undef(), dataArgs), opts);
  });

  JsValue handleTableRow = JS.methodRest((JsValue _self, JsValue args) => {
    JsValue node = args[0];
    JsValue state = args[2];
    JsValue info = args[3];
    JsValue rowArgs = JS.array();
    push(rowArgs, node);
    push(rowArgs, state);
    push(rowArgs, info);
    JsValue row = JS.call(JS.get(handleTableRowAsData, "apply"), handleTableRowAsData, undef(), rowArgs);
    JsValue matrix = JS.array();
    push(matrix, row);
    JsValue opts = JS.object();
    objSet(opts, "alignDelimiters", alignDelimiters);
    objSet(opts, "padding", padding);
    objSet(opts, "stringLength", stringLength);
    string value = markdownTable(matrix, opts);
    return value.slice(0, value.indexOf("\n"));
  });

  JsValue inlineCodeWithTable = JS.methodRest((JsValue _self, JsValue args) => {
    JsValue node = args[0];
    JsValue parent = args[1];
    JsValue state = args[2];
    JsValue value = JS.call(objGet(defaultHandlers, "inlineCode"), undef(), node, parent, state);
    if (JS.call(JS.get(objGet(state, "stack"), "includes"), objGet(state, "stack"), "tableCell").truthy()) {
      value = replaceFn(value, pipeOnly, JS.methodRest((JsValue _s, JsValue m) => {
        return "\\" + jsString(m[0]);
      }));
    }
    return value;
  });

  JsValue unsafe = JS.array();
  JsValue u1 = JS.object();
  objSet(u1, "character", "\r");
  objSet(u1, "inConstruct", "tableCell");
  push(unsafe, u1);
  JsValue u2 = JS.object();
  objSet(u2, "character", "\n");
  objSet(u2, "inConstruct", "tableCell");
  push(unsafe, u2);
  JsValue u3 = JS.object();
  objSet(u3, "atBreak", true);
  objSet(u3, "character", "|");
  objSet(u3, "after", "[\\t :-]");
  push(unsafe, u3);
  JsValue u4 = JS.object();
  objSet(u4, "character", "|");
  objSet(u4, "inConstruct", "tableCell");
  push(unsafe, u4);
  JsValue u5 = JS.object();
  objSet(u5, "atBreak", true);
  objSet(u5, "character", ":");
  objSet(u5, "after", "-");
  push(unsafe, u5);
  JsValue u6 = JS.object();
  objSet(u6, "atBreak", true);
  objSet(u6, "character", "-");
  objSet(u6, "after", "[:|-]");
  push(unsafe, u6);
  JsValue handlers = JS.object();
  pin(handlers, "inlineCode", inlineCodeWithTable);
  pin(handlers, "table", handleTable);
  pin(handlers, "tableCell", handleTableCell);
  pin(handlers, "tableRow", handleTableRow);
  JsValue ext = JS.object();
  pin(ext, "unsafe", unsafe);
  pin(ext, "handlers", handlers);
  return ext;
}
