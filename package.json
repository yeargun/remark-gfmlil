{
  "name": "@itslil/remark-gfm",
  "version": "4.0.3",
  "description": "remark-gfm reimplemented in LilScript",
  "keywords": [
    "autolink",
    "footnote",
    "remark",
    "gfm",
    "github",
    "markdown",
    "mdast",
    "plugin",
    "remark-plugin",
    "strikethrough",
    "table",
    "tables",
    "tasklist",
    "unified",
    "lilscript",
    "itslil"
  ],
  "homepage": "https://yeargun.github.io/remark-gfmlil/",
  "bugs": "https://github.com/yeargun/remark-gfmlil/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yeargun/remark-gfmlil.git"
  },
  "license": "MIT",
  "author": "yeargun",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/remark-gfm.cjs",
  "module": "./dist/remark-gfm.esm.js",
  "types": "./dist/remark-gfm.d.ts",
  "unpkg": "./dist/remark-gfm.umd.js",
  "jsdelivr": "./dist/remark-gfm.umd.js",
  "exports": {
    ".": {
      "types": "./dist/remark-gfm.d.ts",
      "import": "./dist/remark-gfm.esm.js",
      "require": "./dist/remark-gfm.cjs",
      "default": "./dist/remark-gfm.esm.js"
    },
    "./closed": "./dist/remark-gfm.closed.js",
    "./dist/*": "./dist/*",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "dist/remark-gfm.esm.js",
    "dist/remark-gfm.cjs",
    "dist/remark-gfm.umd.js",
    "dist/remark-gfm.closed.js",
    "dist/remark-gfm.d.ts",
    "LICENSE",
    "NOTICE.md",
    "README.md"
  ],
  "sideEffects": [
    "./dist/remark-gfm.cjs",
    "./dist/remark-gfm.closed.js",
    "./dist/remark-gfm.esm.js",
    "./dist/remark-gfm.raw.js",
    "./dist/remark-gfm.umd.js"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "node scripts/build.mjs --compile",
    "build:site": "node scripts/build-site.mjs",
    "test": "npm run check:types && node --test-concurrency=1 --test test/*.test.mjs test/official/index.js",
    "check:types": "tsc --noEmit --strict --exactOptionalPropertyTypes --module NodeNext --moduleResolution NodeNext --target ES2022 test/types.test.ts",
    "check:site": "npm run build:site && node --test-concurrency=1 --test test/site.test.mjs",
    "check:pack": "node scripts/check-pack.mjs",
    "prepublishOnly": "npm run test:build && npm run check:pack && npm run check:site",
    "test:build": "npm run build && npm test"
  },
  "devDependencies": {
    "esbuild": "0.28.1",
    "is-hidden": "^2.0.0",
    "remark": "^15.0.0",
    "string-width": "^6.0.0",
    "typescript": "^5.0.0"
  }
}
